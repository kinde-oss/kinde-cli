{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "inputs": [
        {
        "id": "commandline",
        "type": "promptString",
        "description": "Enter the Kinde domain (e.g., hello.kinde.com)",
        "default": "app.kinde.com"
        }
    ],    "configurations": [{
        "name": "kinde",
        "type": "go",
        "request": "launch",
        "mode": "auto",
        "program": "${workspaceFolder}/cmd/kinde",
        "args": []
    },{
        "name": "kinde version",
        "type": "go",
        "request": "launch",
        "mode": "auto",
        "program": "${workspaceFolder}/cmd/kinde",
        "args": ["version"]
    },{
        "name": "kinde login",
        "type": "go",
        "request": "launch",
        "mode": "auto",
        "program": "${workspaceFolder}/cmd/kinde",
        "args": ["login", "--domain", "${input:commandline}"]
    },{
        "name": "kinde whoami",
        "type": "go",
        "request": "launch",
        "mode": "auto",
        "program": "${workspaceFolder}/cmd/kinde",
        "args": ["whoami" ]
    },{
        "name": "kinde logout",
        "type": "go",
        "request": "launch",
        "mode": "auto",
        "program": "${workspaceFolder}/cmd/kinde",
        "args": ["logout" ]
    },{
        "name": "kinde build",
        "type": "go",
        "request": "launch",
        "mode": "auto",
        "program": "${workspaceFolder}/cmd/kinde",
        "args": ["build", "--cwd", "${workspaceFolder}/testData/kindeSrc/environment/workflows/evTest"]
    }]
}